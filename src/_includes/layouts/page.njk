---
layout: layouts/guide.njk
bodyClass: page-template
---
{%- set g = guides[guide] -%}
<header class="post-header{% if feature_image %} has-cover{% endif %}">
	<div class="inner">
		<h1 class="post-title">{{ title }}</h1>
		{%- if feature_image %}
		<div class="post-cover cover">
			{{ feature_image | coverImg(title) | safe }}
		</div>
		{%- endif %}
	</div>
</header>

<main class="content" role="main">
	<article class="post">
		<div class="inner">

			<section class="post-content">
<!-- content:start -->
{{ content | guideLinks(guide) | safe }}
<!-- content:end -->
			</section>

		</div>
	</article>
</main>
