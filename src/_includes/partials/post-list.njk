{% for post in posts %}
<article class="post{% if post.data.featured %} featured{% endif %}">
	<div class="inner">
		<div class="box post-box">
			<h2 class="post-title"><a href="{{ post.url }}">{{ post.data.title }}</a></h2>
			<span class="post-meta">
				By {{ g.author.name }}
				{%- set pt = g.tags | findTag(post.data.tags) %}
				{%- if pt %} in <a class="post-meta-tag" href="/guides/{{ g.slug }}/tag/{{ pt.slug }}/">{{ pt.name }}</a>{% endif %}
				on <time datetime="{{ post.date | isoDate }}">{{ post.date | isoDate }}</time>
			</span>
			<p class="post-excerpt">{{ post.data.excerpt }}&hellip;</p>
		</div>
	</div>
</article>
{% endfor %}
