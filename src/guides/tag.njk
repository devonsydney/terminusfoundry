---
layout: layouts/guide.njk
bodyClass: tag-template
pagination:
  data: collections.guideTagPages
  size: 1
  alias: tp
permalink: "/guides/{{ tp.guide }}/tag/{{ tp.tag.slug }}/"
eleventyComputed:
  guide: "{{ tp.guide }}"
  title: "{{ tp.tag.name }}"
---
{%- set g = guides[guide] -%}
<header class="blog-header">
	<div class="inner">
		<div class="archive archive-tag box archive-box">
			<span class="archive-info">
				<span class="archive-type">Topic</span>
				<span class="archive-count">{{ tp.posts.length }} {{ "Post" if tp.posts.length == 1 else "Posts" }}</span>
			</span>
			<h2 class="archive-title">{{ tp.tag.name }}</h2>
		</div>
	</div>
</header>

<div id="index" class="container">
	<main class="content" role="main">
		{%- set posts = tp.posts %}
{% include "partials/post-list.njk" %}
	</main>
</div>
