---
layout: layouts/guide.njk
bodyClass: home-template
pagination:
  data: guides
  size: 1
  alias: g0
  resolve: values
permalink: "/guides/{{ g0.slug }}/"
eleventyComputed:
  guide: "{{ g0.slug }}"
---
{%- set g = guides[guide] -%}
<header class="blog-header has-cover">
	<div class="inner">
		<div class="box blog-box">
			<h1 class="blog-name">{{ g.title }}</h1>
			<span class="blog-description">{{ g.description }}</span>
		</div>
		<div class="blog-cover cover">
			{{ g.cover | coverImg(g.title) | safe }}
		</div>
	</div>
</header>

<div id="index" class="container">
	<main class="content" role="main">
		{%- set home = collections.guideHomes | whereGuide(g.slug) | first %}
		{%- if home %}
		<article class="post guide-intro">
			<div class="inner">
				<section class="post-content">
<!-- content:start -->
{{ home.templateContent | guideLinks(g.slug) | safe }}
<!-- content:end -->
				</section>
			</div>
		</article>
		{%- endif %}
	</main>
</div>
