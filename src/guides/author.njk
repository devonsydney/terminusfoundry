---
layout: layouts/guide.njk
bodyClass: author-template
pagination:
  data: guides
  size: 1
  alias: g0
  resolve: values
permalink: "/guides/{{ g0.slug }}/author/{{ g0.author.slug }}/"
eleventyComputed:
  guide: "{{ g0.slug }}"
  title: "{{ g0.author.name }}"
---
{%- set g = guides[guide] -%}
{%- set posts = collections[g.slug + "Posts"] | reverse -%}
<header class="blog-header has-cover">
	<div class="inner">
		<div class="archive archive-author box archive-box">
			<span class="archive-info">
				<span class="archive-type">Author</span>
				<span class="archive-count">{{ posts.length }} {{ "Post" if posts.length == 1 else "Posts" }}</span>
			</span>
			<figure class="archive-avatar avatar"><img eleventy:ignore src="{{ g.author.avatar }}" alt="{{ g.author.name }}" width="800" height="800"></figure>
			<h2 class="archive-title">{{ g.author.name }}</h2>
		</div>
		<div class="blog-cover cover">
			{{ g.author.cover | coverImg(g.title) | safe }}
		</div>
	</div>
</header>

<div id="index" class="container">
	<main class="content" role="main">
{% include "partials/post-list.njk" %}
	</main>
</div>
