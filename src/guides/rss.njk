---
pagination:
  data: guides
  size: 1
  alias: g
  resolve: values
permalink: "/guides/{{ g.slug }}/rss.xml"
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="utf-8"?>
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom" xmlns:content="http://purl.org/rss/1.0/modules/content/" xmlns:dc="http://purl.org/dc/elements/1.1/">
	<channel>
		<title>{{ g.title }}</title>
		<link>{{ site.url }}/guides/{{ g.slug }}/</link>
		<atom:link href="{{ site.url }}{{ page.url }}" rel="self" type="application/rss+xml"/>
		<description>{{ g.description }}</description>
		<language>{{ site.lang }}</language>
		<lastBuildDate>{{ collections[g.slug + "Posts"] | getNewestCollectionItemDate | dateToRfc822 }}</lastBuildDate>
		{%- for post in collections[g.slug + "Posts"] | reverse %}
		<item>
			<title>{{ post.data.title }}</title>
			<link>{{ site.url }}{{ post.url }}</link>
			<guid isPermaLink="false">{{ post.data.ghost_uuid }}</guid>
			<pubDate>{{ post.date | dateToRfc822 }}</pubDate>
			<dc:creator>{{ g.author.name }}</dc:creator>
			<description>{{ post.data.excerpt }}</description>
			<content:encoded><![CDATA[{{ post.templateContent | guideLinks(g.slug, true) | htmlToAbsoluteUrls(site.url) | safe }}]]></content:encoded>
		</item>
		{%- endfor %}
	</channel>
</rss>
